
# aliases are abbreviations

abbr cl "clear"
abbr cp "cp -iv"


abbr df "df -h"
abbr dif "difft"
abbr du "du -h"
abbr greppy "grep -nrI --include=\*.py"
abbr grepmd "grep -nrI --include=\*.md"
abbr grepjs "grep -nrI --include=\*.js"
abbr e "eza -l"
abbr er "eza -l --sort=accessed" # can be modified, accessed, created
abbr ed "eza -ld */"
# abbr f "find . -type f -name "
abbr h "history"
abbr j "jobs -l"
#
abbr l 'ls -l'
abbr ll 'ls -la'
abbr lr "ls -ltr"
abbr lsd "ls -ld */"
abbr ldr "ls -ldr */"
#
abbr mkdir "mkdir -pv"
abbr mv "mv -iv"
abbr rm "rm -iv"
abbr rp "realpath -s"
#
abbr tmux "tmux -2"
abbr ta "tmux attach-session -t"
abbr tl "tmux ls"
abbr tn "tmux new -s"
abbr tkill "tmux kill-session -t"
#
abbr v "vim"
abbr vim "vim -p"
abbr wl "wc -l"
abbr wh "which"

# nix & home-manager
abbr hmb "home-manager build"
abbr hms "home-manager switch"

abbr lazy "lazygit"
