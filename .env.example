# Copy to .env (not tracked by git) and fill in. install.sh reads it.

# written to ~/.gitconfig.local
# e.g. GITNAME=Jane Doe, EMAIL=jane@example.com (quote values with spaces)
GITNAME=
EMAIL=

# optional: name of your entry in flake.nix homeConfigurations (default: your login name).
# install.sh adds it to flake.nix if it's missing.
# FLAKENAME=
